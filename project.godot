; Engine configuration file.
; 依据 APK 内 assets/project.binary 提取重建（autoload 19 项、主场景名均为二进制内实际值）

config_version=5

[application]

config/name="reD"
run/main_scene="res://tscn/game/GameRoot2.tscn"
config/features=PackedStringArray("4.3")

[autoload]

Shot="*res://shot.gd"

WSLocationData="*res://tscn/global/WSLocationData.tscn"
GlobalBsPart="*res://tscn/global/GlobalBsPart.tscn"
GlobalSoldierInfo="*res://tscn/global/GlobalSoldierInfo.tscn"
GlobalNode="*res://tscn/global/GlobalNode.tscn"
GlobalMessageInterface="*res://tscn/global/GlobalMessageInterface.tscn"
GlobalLocationData="*res://tscn/global/GlobalLocationData.tscn"
WordTransitionUtils="*res://tscn/global/WordTransitionUtils.tscn"
GlobalApplication="*res://tscn/global/GlobalApplication.tscn"
GlobalSave="*res://tscn/global/GlobalSave.tscn"
GlobalTimeControl="*res://tscn/global/GlobalTimeControl.tscn"
GlobalPlayerConfig="*res://tscn/global/GlobalPlayerConfig.tscn"
GlobalSoundManager="*res://tscn/global/GlobalSoundManager.tscn"
WSData="*res://tscn/global/WSData.tscn"
GlobalEventData="*res://tscn/global/GlobalEventData.tscn"
GlobalNpcTeamData="*res://tscn/global/GlobalNpcTeamData.tscn"
GlobalLoadPage="*res://tscn/global/GlobalLoadPage.tscn"
GlobalCountryData="*res://tscn/global/GlobalCountryData.tscn"
GlobalTempData="*res://tscn/global/GlobalTempData.tscn"
BattleSceneTransition="*res://tscn/game/interface/ws/BattleSceneTransition.tscn"

[rendering]
textures/canvas_textures/default_texture_filter=0

[debug]

gdscript/warnings/native_method_override=0
